// Smart HRM - Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  // No @Roles() guard grants this elevated access yet -- for now a
  // Managing Director account sees the same modules as HR/MANAGER/
  // SUPERVISOR (everything except System Settings, which stays ADMIN-only).
  // A dedicated Managing Director dashboard/permission set is planned as
  // separate follow-up work.
  MANAGING_DIRECTOR
  HR
  MANAGER
  // Narrower than MANAGER: can approve/reject a leave request only when
  // they're the currently-resolved approver for a tier in that department's
  // approval chain (see LeaveApprovalTier) -- no override power, no access
  // to reports, org structure, users, devices, or logging leave on behalf
  // of someone else. Typically the first tier (e.g. "Supervisor") in a
  // department's chain.
  SUPERVISOR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// Picked on the Add/Edit Employee form (under Hired Date) -- decides which
// kind of login this person gets, see EmployeesService/UsersService:
//   EMPLOYEE/MANAGER/SUPERVISOR/MANAGING_DIRECTOR -> an Employee ID login
//     (see UsersService.EMPLOYEE_ID_LOGIN_ROLES). The value picked here IS
//     that login's real system Role -- Manager grants real Manager access,
//     Supervisor grants real Supervisor access, and so on, all while still
//     signing in with the Employee ID rather than a separate username/
//     password. Same dashboard/permissions either way: a Manager made here
//     and a Manager made from System Settings > Add Staff User (a
//     traditional username/password login) are identical once signed in --
//     only the login method differs. See UsersService.syncLoginForEmployeeRole.
//   ADMINISTRATOR -> a staff login (role ADMIN) with a chosen username and
//     password instead of an Employee ID, provisioned right from this form.
enum EmployeeRole {
  EMPLOYEE
  MANAGER
  SUPERVISOR
  // Grants real Managing Director access via Employee ID login, same as
  // MANAGER/SUPERVISOR above -- added so Managing Director shows up as its
  // own Employee Role instead of being lumped in under Manager. A dedicated
  // Managing Director dashboard is planned as separate follow-up work, not
  // tied to this enum value.
  MANAGING_DIRECTOR
  ADMINISTRATOR
}

enum SyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
}

enum DeviceConnectionStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum AttendanceSource {
  FINGERPRINT
  FACE
  RFID
  PIN
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum SyncOperation {
  PUSH_NEW
  UPDATE
  DELETE
  DISABLE
  BULK
}

enum SyncResultStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum LeaveTierType {
  REPORTING_SUPERIOR // resolved dynamically per-request from Employee.reportingSuperior
  SPECIFIC_USER      // a fixed User assigned to this tier when the workflow is configured
}

// The employee's leave-policy category -- distinct from EmploymentType
// (which is about the job arrangement: full/part time, contract, intern).
// This is what the Leave Policy screen keys entitlements off of.
// Employee-type categories (Permanent, Provision, Contractual, Trial by
// default) -- HR-configurable rather than a fixed list, since different
// hospitals name and structure these differently. The two flags below are
// what LeaveSchedulerService reads instead of hardcoding category names:
//  - accruesRollover: does this category build up a leave balance that
//    carries across the employee's personal anniversary (Permanent/
//    Contractual-style)? Off for temporary/probationary categories that
//    don't accrue long-term balance.
//  - hasFixedPeriod: is this a temporary status HR needs to revisit before
//    it ends (Provision's probation, Trial's trial period)? When on,
//    defaultPeriodMonths is the default length (an individual employee's
//    own Employee.trialMonths overrides it, e.g. HR picking a custom Trial
//    length per hire).
model EmployeeCategory {
  id                  String   @id @default(uuid())
  name                String   @unique
  code                String   @unique
  accruesRollover     Boolean  @default(true)
  hasFixedPeriod      Boolean  @default(false)
  defaultPeriodMonths Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employees        Employee[]
  categoryPolicies LeaveCategoryPolicy[]

  @@map("employee_categories")
}

// Flags a LeaveType that needs extra handling beyond a plain balance
// deduction -- Compensatory checks past attendance, Maternity checks
// tenure/gender and requires an attached document.
enum LeaveSpecialRule {
  NONE
  COMPENSATORY
  MATERNITY
}

enum LeaveDecisionType {
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Tracks a cancellation request against an already-APPROVED LeaveRequest --
// deliberately separate from LeaveRequestStatus (which stays 'APPROVED' the
// whole time a cancellation is being decided) so the leave keeps showing as
// active everywhere (calendar, attendance, balances) until the cancellation
// itself is fully approved. Only then does LeaveRequest.status flip to
// CANCELLED and the balance/attendance side effects reverse.
enum LeaveCancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveSession {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(HR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set true on an auto-provisioned employee login (see EmployeesService)
  // so the default password (the Employee ID) can't be used indefinitely --
  // the employee portal blocks on a "set a new password" screen until this
  // clears. Manually-created staff accounts (ADMIN/HR/MANAGER/SUPERVISOR
  // via System Settings) get a real password up front, so this stays false
  // for those unless an admin resets a password and wants to force a change.
  mustChangePassword Boolean @default(false)

  auditLogs AuditLog[]
  leaveRequestsApplied       LeaveRequest[] @relation("LeaveAppliedBy")
  leaveRequestsDecided       LeaveRequest[] @relation("LeaveDecidedBy")
  leaveCancellationRequested LeaveRequest[] @relation("LeaveCancellationRequester")

  // One login account per Employee at most -- set when this User IS that
  // Employee (an EMPLOYEE self-service account, or a staff member who is
  // also an Employee in the org chart).
  employeeId String?  @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  tierAssignments       LeaveApprovalTier[]         @relation("LeaveTierApprover")
  tierDecisions         LeaveApprovalDecision[]     @relation("LeaveTierDecisionApprover")
  cancellationDecisions LeaveCancellationDecision[] @relation("LeaveCancellationDecisionApprover")
  notifications   Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  logo        String?
  address     String?
  phone       String?
  email       String?
  website     String?
  timeZone    String   @default("UTC")
  officeHours String?
  workingDays String? // comma separated e.g. "Mon,Tue,Wed,Thu,Fri"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company")
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------
//
// Hierarchy: Company -> Department -> Employee. Branch, Location, Grade,
// Section and Sub-Department were removed (they were optional, lightly-used
// extra layers) -- Department is the level everything else (Designation,
// leave workflow tiers, roster, etc.) actually organizes around.

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  headEmployeeId String?
  status         OrgUnitStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manager        Employee?        @relation("DepartmentManager", fields: [headEmployeeId], references: [id])
  employees      Employee[]
  designations   Designation[]
  superiors      DepartmentSuperior[]
  approvalWorkflow LeaveApprovalWorkflow?

  @@map("departments")
}

model Designation {
  id           String        @id @default(uuid())
  title        String        @unique
  departmentId String? // department this designation primarily applies to; null = applies anywhere
  status       OrgUnitStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@map("designations")
}

// One row per (department, employee, title) assignment, so a department
// can have several superiors with different titles ("Department Head",
// "Shift Supervisor", ...) and one employee can be a superior of more than
// one department.
model DepartmentSuperior {
  id              String   @id @default(uuid())
  departmentId    String?
  employeeId      String
  title           String // e.g. "Department Head", "Assistant Department Head", "Shift Supervisor"
  createdAt       DateTime @default(now())

  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employee      Employee       @relation("DepartmentSuperiorEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([departmentId, employeeId, title])
  @@map("department_superiors")
}

model Shift {
  id             String   @id @default(uuid())
  name           String
  startTime      String   // "09:00"
  endTime        String   // "18:00"
  graceMinutes   Int      @default(10)
  breakMinutes   Int      @default(60)
  weekendRule    String?  // comma separated days off, e.g. "Fri,Sat"
  overtimeRule   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees Employee[]
  rosterAssignments RosterAssignment[]

  @@map("shifts")
}

enum RosterDayType {
  SHIFT
  OFF
}

// One row per (employee, date) once a manager has made a call for that day --
// either a specific Shift ("SHIFT" + shiftId) or a deliberate day off ("OFF",
// shiftId left null). No row at all means nobody has assigned anything yet
// for that employee/date (the Roster screen's "+ Assign" state) -- this is
// deliberately a *planned* schedule, separate from AttendanceRecord, which is
// the *actual* punches/status once the day happens.
model RosterAssignment {
  id         String        @id @default(uuid())
  employeeId String
  date       DateTime      @db.Date
  type       RosterDayType @default(SHIFT)
  shiftId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("roster_assignments")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

model Employee {
  id               String         @id @default(uuid())
  employeeCode     String         @unique
  fullName         String
  photo            String?
  dateOfBirth      DateTime?
  gender           String?
  nationalId       String?
  passport         String?
  bloodGroup       String?
  maritalStatus    String?

  phone            String?
  email            String?
  address          String?
  emergencyContact String?

  joiningDate      DateTime?
  departmentId     String?
  designationId    String?
  shiftId          String?
  reportingSuperiorId String?
  employmentType   EmploymentType @default(FULL_TIME)
  salary           Decimal?       @db.Decimal(12, 2)
  status           EmployeeStatus @default(ACTIVE)

  // Which kind of login this person gets -- see the EmployeeRole enum
  // above for what each value means and EmployeesService/UsersService for
  // how it's provisioned.
  employeeRole     EmployeeRole   @default(EMPLOYEE)

  // Leave policy category -- required going forward (nullable only so this
  // migration doesn't break existing rows; the Employee form makes it a
  // required pick for every new hire). trialMonths is set only when
  // leaveCategory = TRIAL. categorySince anchors the category's own clock
  // (Provision/Trial period end, Permanent/Contractual anniversary) -- it
  // starts at joiningDate and is reset whenever HR changes the category
  // (e.g. Provision -> Permanent, or extending Provision another term).
  leaveCategoryId  String?
  trialMonths      Int?
  categorySince    DateTime?

  // Biometric / device sync
  deviceUserId     String?        @unique
  syncStatus       SyncStatus     @default(NOT_SYNCED)
  lastSyncDate     DateTime?
  fingerprintEnrolled Boolean     @default(false)
  faceEnrolled        Boolean     @default(false)
  rfidEnrolled         Boolean    @default(false)
  rfidCardNumber       String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  department       Department?    @relation(fields: [departmentId], references: [id])
  designation      Designation?   @relation(fields: [designationId], references: [id])
  shift            Shift?         @relation(fields: [shiftId], references: [id])
  reportingSuperior Employee?     @relation("EmployeeSuperior", fields: [reportingSuperiorId], references: [id])
  leaveCategory     EmployeeCategory? @relation(fields: [leaveCategoryId], references: [id])

  subordinates      Employee[]           @relation("EmployeeSuperior")
  managedDepartments    Department[]     @relation("DepartmentManager")
  superiorRoles     DepartmentSuperior[] @relation("DepartmentSuperiorEmployee")
  attendanceLogs    AttendanceLog[]
  attendanceRecords AttendanceRecord[]
  rosterAssignments RosterAssignment[]
  syncHistory       SyncHistory[]
  documents         Document[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  account           User?

  @@map("employees")
}

model Document {
  id         String   @id @default(uuid())
  employeeId String
  type       String   // Resume, Contract, Certificate, Identification, Leave Attachment
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())

  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@map("documents")
}

// ---------------------------------------------------------------------------
// Device
// ---------------------------------------------------------------------------

model Device {
  id                 String                  @id @default(uuid())
  name               String
  deviceModel        String                  @default("ZKTeco uFace 800 Plus")
  ipAddress          String
  port               Int                     @default(4370)
  serialNumber       String?                 @unique
  firmwareVersion    String?
  connectionStatus   DeviceConnectionStatus  @default(UNKNOWN)
  lastCommunication  DateTime?
  deviceTime         DateTime?
  storageUsed        Int?                    // percentage
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  attendanceLogs AttendanceLog[]
  deviceLogs     DeviceLog[]
  syncHistory    SyncHistory[]

  @@map("devices")
}

model DeviceLog {
  id        String   @id @default(uuid())
  deviceId  String
  level     String   // INFO, WARNING, ERROR
  message   String
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_logs")
}

// ---------------------------------------------------------------------------
// Synchronization
// ---------------------------------------------------------------------------

model SyncHistory {
  id         String            @id @default(uuid())
  employeeId String?
  deviceId   String?
  operation  SyncOperation
  status     SyncResultStatus
  message    String?
  createdAt  DateTime          @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id])
  device   Device?   @relation(fields: [deviceId], references: [id])

  @@map("sync_history")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

// Raw punches as they arrive from the device (or manual entry)
model AttendanceLog {
  id         String           @id @default(uuid())
  employeeId String
  deviceId   String?
  timestamp  DateTime
  source     AttendanceSource @default(FINGERPRINT)
  inOutMode  String?          // "IN" | "OUT" | "BREAK_OUT" | "BREAK_IN"
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id])

  // Belt-and-suspenders against duplicate punches: the application layer
  // already de-dupes by (employeeId, timestamp) before inserting, but this
  // constraint makes it impossible even if two syncs somehow overlap.
  @@unique([employeeId, timestamp])
  @@index([employeeId, timestamp])
  @@map("attendance_logs")
}

// Processed, one row per employee per day
model AttendanceRecord {
  id               String            @id @default(uuid())
  employeeId       String
  date             DateTime          @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  workHours        Decimal?          @db.Decimal(5, 2)
  lateMinutes      Int               @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes  Int               @default(0)
  status           AttendanceStatus  @default(PRESENT)
  approved         Boolean           @default(false)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                  String           @id @default(uuid())
  name                String           @unique
  code                String           @unique
  daysPerYear         Decimal          @db.Decimal(5, 1) @default(0)
  paid                Boolean          @default(true)
  carryForward        Boolean          @default(false)
  maxCarryForwardDays Decimal?         @db.Decimal(5, 1)
  requiresApproval    Boolean          @default(true)
  color               String?
  isActive            Boolean          @default(true)
  // NONE = plain balance-based leave type, using daysPerYear/carryForward
  // above unless a LeaveCategoryPolicy row overrides it for a given
  // employee category. COMPENSATORY/MATERNITY route through the extra
  // checks in LeaveService instead of a flat annual allocation.
  specialRule         LeaveSpecialRule @default(NONE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  balances         LeaveBalance[]
  requests         LeaveRequest[]
  categoryPolicies LeaveCategoryPolicy[]

  @@map("leave_types")
}

// Per (employee category, leave type) entitlement -- lets Permanent/
// Provision/Contractual all grant different Casual/Sick/Annual amounts
// under the same LeaveType row, with their own carry-forward rules. A
// category with no row for a given leave type gets none of it (this is how
// Trial ends up with zero Casual/Sick/Annual, and how Provision/Contractual
// simply don't have an Annual-leave row).
model LeaveCategoryPolicy {
  id                  String   @id @default(uuid())
  leaveCategoryId     String
  leaveTypeId         String
  daysPerCycle        Decimal  @db.Decimal(5, 1)
  carryForward        Boolean  @default(false)
  maxCarryForwardDays Decimal? @db.Decimal(5, 1)
  // A category-wide default: the unused balance rolls over exactly once
  // into the next cycle, and after that the policy stops granting new days
  // at all (the employee just spends down whatever's left, then it's gone).
  carryForwardOnce    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  leaveCategory EmployeeCategory @relation(fields: [leaveCategoryId], references: [id])
  leaveType     LeaveType        @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([leaveCategoryId, leaveTypeId])
  @@map("leave_category_policies")
}

model LeaveBalance {
  id             String   @id @default(uuid())
  employeeId     String
  leaveTypeId    String
  year           Int
  allocated      Decimal  @db.Decimal(5, 1) @default(0)
  carriedForward Decimal  @db.Decimal(5, 1) @default(0)
  used           Decimal  @db.Decimal(5, 1) @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String             @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  session         LeaveSession       @default(FULL_DAY)
  totalDays       Decimal            @db.Decimal(5, 1)
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  rejectionReason String?
  appliedById     String?
  decidedById     String?
  decidedAt       DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Compensatory leave only: the past on-duty date this request claims
  // extra hours against (see LeaveService.getCompensatoryEligibility).
  compensatoryForDate DateTime? @db.Date
  // Maternity leave only (required by policy, but kept generic so any
  // future leave type can attach a document the same way).
  attachmentId        String?
  attachment          Document? @relation(fields: [attachmentId], references: [id])

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  appliedBy User?     @relation("LeaveAppliedBy", fields: [appliedById], references: [id])
  decidedBy User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decisions LeaveApprovalDecision[]

  // Null = no approval chain configured for this employee's department (the
  // original simple flow: any ADMIN/HR/MANAGER may decide it). Otherwise the
  // order of the LeaveApprovalTier currently holding this request.
  currentTierOrder Int?

  // Cancelling an already-APPROVED leave is its own mini approval chain --
  // the same department tiers that approved the leave, walked again, with
  // an implicit final "HR Admin" tier appended (see
  // LeaveService.getCancellationChain). cancellationStatus is null until
  // the employee actually requests a cancellation; PENDING while it's being
  // decided; APPROVED once fully approved (at which point status flips to
  // CANCELLED); REJECTED if any tier turns it down (the leave stays
  // APPROVED and the employee may request again).
  cancellationStatus           LeaveCancellationStatus?
  cancellationReason           String?
  cancellationCurrentTierOrder Int?
  cancellationRequestedAt      DateTime?
  cancellationRequestedById    String?
  cancellationRequestedBy      User?                       @relation("LeaveCancellationRequester", fields: [cancellationRequestedById], references: [id])
  cancellationDecisions        LeaveCancellationDecision[]

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Leave approval workflow (per-department tier chain)
// ---------------------------------------------------------------------------

model LeaveApprovalWorkflow {
  id           String   @id @default(uuid())
  departmentId String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tiers      LeaveApprovalTier[]

  @@map("leave_approval_workflows")
}

model LeaveApprovalTier {
  id             String        @id @default(uuid())
  workflowId     String
  order          Int
  label          String
  type           LeaveTierType
  // Required when type = SPECIFIC_USER; unused for REPORTING_SUPERIOR.
  approverUserId String?

  workflow LeaveApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approver User?                 @relation("LeaveTierApprover", fields: [approverUserId], references: [id])

  @@unique([workflowId, order])
  @@map("leave_approval_tiers")
}

model LeaveApprovalDecision {
  id         String             @id @default(uuid())
  requestId  String
  tierOrder  Int
  tierLabel  String
  approverId String?
  decision   LeaveDecisionType
  reason     String?
  decidedAt  DateTime           @default(now())

  request  LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?        @relation("LeaveTierDecisionApprover", fields: [approverId], references: [id])

  @@map("leave_approval_decisions")
}

// One row per tier decided on a leave CANCELLATION request -- structurally
// identical to LeaveApprovalDecision, kept as its own table (rather than
// reusing that one with a "phase" flag) so a request's original approval
// trail and its cancellation trail never intermix in either table.
model LeaveCancellationDecision {
  id         String             @id @default(uuid())
  requestId  String
  tierOrder  Int
  tierLabel  String
  approverId String?
  decision   LeaveDecisionType
  reason     String?
  decidedAt  DateTime           @default(now())

  request  LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?        @relation("LeaveCancellationDecisionApprover", fields: [approverId], references: [id])

  @@map("leave_cancellation_decisions")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // e.g. "EMPLOYEE_CREATED"
  entity    String   // e.g. "Employee"
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  LEAVE
  SHIFT
}

// Lightweight in-app notification feed for an employee's own portal -- a
// leave request being approved/rejected/advanced to the next approval tier,
// or a manager assigning/changing/clearing a day on the Roster, each drops
// one row here for that employee. Read status is tracked per row rather
// than a single "last seen" cursor so the bell's unread count and the list
// itself always agree.
// Notifications belong to a login (User), not an Employee -- a plain staff
// account (ADMIN/HR/MANAGER/SUPERVISOR with no linked Employee, e.g. an
// approver added only via System Settings) gets notified exactly the same
// way an Employee Portal login does, through the same table, the same
// /notifications/mine endpoint, and the same bell component (see
// components/shell/NotificationBell.tsx, used on both the staff top bar
// and the Employee Portal). Nothing about "who this notification is for"
// branches on staff vs. employee anywhere in the stack.
model Notification {
  id         String               @id @default(uuid())
  userId     String
  category   NotificationCategory
  title      String
  message    String
  isRead     Boolean              @default(false)
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
