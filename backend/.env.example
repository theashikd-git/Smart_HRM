# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://hrm_user:hrm_password@localhost:5432/smart_hrm?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# ZKTeco biometric device (uFace 800 Plus)
# ---------------------------------------------------------------------------

# Biometric device driver: "mock" (default, no hardware needed) or "real"
# (connects to an actual ZKTeco uFace 800 Plus over TCP). See README.md
# "Connecting a real ZKTeco device" section before switching to "real", and
# backend/src/devices/zkteco/zkteco-real-client.ts for what "real" does and
# does not support.
ZKTECO_DRIVER="mock"

# How long to wait for the initial TCP connect before giving up (ms).
# node-zklib itself does not enforce a connect timeout, so this is what
# actually prevents a wrong-IP or powered-off device from hanging a request.
ZKTECO_CONNECT_TIMEOUT_MS=8000

# How long to wait for a reply to any single command once connected (ms).
# Also used as node-zklib's internal per-request timeout.
ZKTECO_RESPONSE_TIMEOUT_MS=8000

# How many times to retry the initial connect (with backoff) before
# reporting the device unreachable. Total connect attempts = this + 1.
ZKTECO_CONNECT_RETRIES=2

# Close a pooled device connection if nothing has used it for this long
# (ms). ZKTeco terminals generally accept only ONE active TCP session at a
# time, so releasing idle connections keeps the device's own menu (or
# BioTime, if still installed) from being locked out.
ZKTECO_IDLE_TIMEOUT_MS=300000

# How often (ms) to automatically pull new punches from the primary
# device in the background, in addition to the manual "Sync now" button.
# Set to 0 to disable automatic syncing.
ATTENDANCE_SYNC_INTERVAL_MS=300000

# How often (ms) to ping every configured device in the background to
# keep Device.connectionStatus accurate (so the UI reflects a device
# coming back online without a human clicking "Test connection").
# Set to 0 to disable.
DEVICE_HEARTBEAT_INTERVAL_MS=60000

# How often (ms) to automatically retry employees whose push to the
# device previously failed (NOT_SYNCED/PENDING/FAILED), in addition to the
# manual "Retry Failed" / "Bulk Sync All" buttons on the Device page.
# Set to 0 to disable.
EMPLOYEE_SYNC_RETRY_INTERVAL_MS=300000
